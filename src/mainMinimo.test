
#include <Arduino.h>
#include <WiFi.h>

#define WIFI_SSID  "GLS"
#define WIFI_SENHA "Lola09876543*"

void setup()
{
    Serial.begin(115200);
    delay(2000);

    Serial.println("\nESP32-C3 WiFi Test");

    WiFi.mode(WIFI_STA);
    WiFi.setSleep(false);
    WiFi.begin(WIFI_SSID, WIFI_SENHA);

    Serial.printf("Conectando a %s...\n", WIFI_SSID);
}

void loop()
{
    static uint32_t ultimaLeitura = 0;

    if (millis() - ultimaLeitura < 3000)
        return;
    ultimaLeitura = millis();

    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.printf(
            "OK IP=%s RSSI=%d dBm MAC=%s\n",
            WiFi.localIP().toString().c_str(),
            WiFi.RSSI(),
            WiFi.macAddress().c_str()
        );
    }
    else
    {
        Serial.printf(
            "Desconectado! Status=%d\n",
            WiFi.status()
        );

        // WiFi.disconnect();
        // WiFi.begin(WIFI_SSID, WIFI_SENHA);
    }
}
