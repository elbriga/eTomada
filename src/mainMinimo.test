#include <Arduino.h>
#include <WiFi.h>

const char *SSID = "GLS";
const char *PASSWORD = "Lola09876543*";

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println("\n=== ESP32-C3 STA TEST ===");

    WiFi.mode(WIFI_STA);
    WiFi.begin(SSID, PASSWORD);

    Serial.print("Conectando");

    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println();
    Serial.println("WiFi conectado!");
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
    Serial.print("Gateway: ");
    Serial.println(WiFi.gatewayIP());
    Serial.print("DNS: ");
    Serial.println(WiFi.dnsIP());
    Serial.print("RSSI: ");
    Serial.println(WiFi.RSSI());
}

void loop()
{
    // TODO ping
    delay(1000);
}
